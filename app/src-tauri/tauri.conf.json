{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Nature Observations",
  "version": "0.1.0",
  "identifier": "org.mynatureobservations.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run notices:generate",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "My Nature Observations",
        "userAgent": "MyNatureObservations/0.1.0 (+https://github.com/MyNatureObservations/my-nature-observations)",
        "width": 1400,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "zoomHotkeysEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "notices/": "notices/"
    }
  }
}
